#!/bin/bash
#SBATCH --job-name=muo-e19-dryrun
#SBATCH --partition=gpu_titan
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --open-mode=append
#SBATCH --output=logs/%x-%j.out

# Stage 19 DRY RUN — the full evaluation pipeline on VALIDATION.
#
# Validation is free to use. This job runs exactly the code path that Stage 20
# will run on the test split, so every remaining unknown of protocol v1.1
# turns into a measured number BEFORE anything irreversible happens:
#
#   * z_thr           99th percentile of |z| over the sham ROIs of the
#                     validation references (report_tables prints it and
#                     writes z_thr_calibration.json)
#   * sigma_d         the paired spread that fixes the power table
#   * X               max(0.30, 3 x rel-SD of C_ref over K)
#   * S2 floors       SSIM_val(f) - max(0.02, 3 SD_cells)
#   * wall and cache  the two operational numbers of the Stage 20 sbatch
#   * ROI overlays    inspected by eye before the ROIs are trusted
#
# After this job, protocol v1.1 is frozen to zero TBDs and Stage 20 is the
# same command with one flag changed.
set -euo pipefail
mkdir -p logs
source scripts/cluster/env_gpu.sh
echo "node=$(hostname) job=${SLURM_JOB_ID:-?} date=$(date -u +%FT%TZ)"

CACHE="${MUOGRAPHY_RUNS}/e19-dryrun-cache"
mkdir -p "$CACHE"

echo "=== Stage 19 unit tests (abort on any failure)"
python scripts/evaluation/test_metrics.py
python scripts/evaluation/test_roi.py
python scripts/evaluation/test_detectability.py
python scripts/evaluation/test_texture.py
python scripts/evaluation/test_stats.py
python scripts/evaluation/test_cache.py
python scripts/evaluation/test_predict.py
python scripts/evaluation/test_equivalence.py
python scripts/evaluation/test_ceiling.py
python scripts/evaluation/test_run_evaluation.py
python scripts/evaluation/test_single_callsite.py
python scripts/evaluation/test_report_tables.py
python scripts/evaluation/test_report_figures.py
python scripts/evaluation/test_factor_analysis.py
python scripts/evaluation/test_blind_panels.py

echo "=== ROI checks V1-V5 on the validation and generalization geometries"
python scripts/evaluation/test_roi_cluster.py \
  --geometries geo-val-01 geo-val-02 geo-val-03 geo-gen-01 \
  --overlay-dir results/evaluation/roi-overlays

echo "=== forward-only inference benchmark (fills the missing measurement)"
python scripts/evaluation/predict_benchmark.py --device cuda \
  --out "${MUOGRAPHY_RUNS}/bench-fwd.json"

echo "=== stochastic SSIM ceiling, regenerated by script (expects ~0.905)"
# report_figures reads this file: the ceiling drawn on the quality curve is
# the regenerated number, never a literal
python scripts/evaluation/ceiling.py --split val --k 20 \
  --out results/evaluation/ceiling.json

echo "=== full evaluation pass on VALIDATION"
python scripts/evaluation/run_evaluation.py --split val --out-root "$CACHE" \
  --runs-root "$MUOGRAPHY_RUNS" --device cuda

echo "=== master tables (z_thr calibration lives here)"
python scripts/evaluation/report_tables.py --cache "$CACHE" \
  --out results/evaluation/fragments

echo "=== exposure-reduction factor (Stage 22 rehearsal on validation)"
# B is lowered here: the dry run measures the wall time and the shape of the
# tables, and the pre-registered B = 10000 is what the real Stage 22 pass uses
python scripts/evaluation/factor_analysis.py --cache "$CACHE" \
  --out results/evaluation/fragments --bootstrap 2000

echo "=== figures (equivalence figure reads factor_tables.json)"
python scripts/evaluation/report_figures.py --cache "$CACHE" \
  --out figures/results \
  --factors results/evaluation/fragments/factor_tables.json \
  --ceiling-json results/evaluation/ceiling.json

echo "=== blind panels (rehearsal on validation; the real ones come from E20)"
python scripts/evaluation/blind_panels.py --cache "$CACHE" \
  --out results/evaluation/blind --raters 3

du -sh "$CACHE"
echo "NIGHT JOB muo-e19-dryrun: COMPLETE"
